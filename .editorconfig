root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts}]
indent_size = 4

[*.{xml,proto}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,md}]
indent_size = 2

[*.gradle.kts]
indent_size = 4
